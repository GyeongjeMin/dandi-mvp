# ─────────────────────────────────────────────
# 단디(DANDI) 백엔드 환경변수 예시
# 이 파일을 복사해 같은 폴더에 .env 로 저장하세요.
#   Windows:  copy .env.example .env
# .env 파일은 절대 공개 저장소(GitHub 등)에 올리지 마세요.
# ─────────────────────────────────────────────

# 서버 포트
PORT=4000

# SQLite 데이터베이스 파일 위치 (server 폴더 기준)
DB_FILE=./data/dandi.sqlite

# AI 제공자: demo | anthropic | openai
#  - demo      : API 키 없이 실행. 단디의 말은 미리 준비된 규칙으로 만들어지고,
#                기억 저장·수정·삭제와 추천 점수 계산은 실제로 동작합니다.
#  - anthropic : Anthropic Claude API 사용
#  - openai    : OpenAI 또는 OpenAI 호환 API(Ollama 등) 사용
LLM_PROVIDER=demo

# Anthropic 설정 (LLM_PROVIDER=anthropic 일 때)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI 호환 설정 (LLM_PROVIDER=openai 일 때) — 모델 이름은 사용 가능한 것으로 꼭 적어 주세요.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
